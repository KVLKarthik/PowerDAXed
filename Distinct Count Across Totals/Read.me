🧮 DAX Implementation
‘‘‘
Products_By_Qtr =
ADDCOLUMNS(
    SUMMARIZE(
        Sales,
        'Calendar'[Year],
        'Calendar'[Qtr]
    ),
    "UNIQUE PRODUCTS",
    CALCULATE(
        DISTINCTCOUNT(Sales[ProductKey])
    )
)
